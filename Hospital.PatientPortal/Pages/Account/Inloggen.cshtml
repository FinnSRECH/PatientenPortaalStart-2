@page
@model Hospital.PatientPortal.Pages.Account.InloggenModel
@{
    ViewData["Title"] = "Inloggen";
}
<div class="auth-shell">
    <section class="auth-card">
        <span class="eyebrow">MIJNZORG</span>
        <h1>Inloggen</h1>
        <p class="muted">Log veilig in om uw persoonlijke dossier te bekijken.</p>
        @if (Model.ErrorMessage is not null) { <div class="alert">@Model.ErrorMessage</div> }
        <form method="post">
            <label asp-for="Input.Email">E-mailadres</label>
            <input asp-for="Input.Email" autocomplete="email" />
            <span asp-validation-for="Input.Email"></span>
            <label asp-for="Input.Password">Wachtwoord</label>
            <input asp-for="Input.Password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password"></span>
            <button type="submit" class="button full">Inloggen</button>
        </form>
        <p class="small">Demo: jan@demo.nl / Welkom123!</p>
        <p>Nog geen account? <a asp-page="/Account/Registreren">Registreren</a></p>
    </section>
</div>
